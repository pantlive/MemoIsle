{
  "manifest_version": 3,
  "name": "MemoIsle @网页",
  "description": "同步当前浏览器打开的网页，并在 MemoIsle 快速捕获中使用 @ 选择网页。",
  "version": "0.1.0",
  "permissions": ["activeTab", "tabs", "contextMenus", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "收藏当前网页到 MemoIsle"
  },
  "commands": {
    "capture-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "收藏当前网页到 MemoIsle"
    }
  }
}
