<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MemoIsle.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 深色模式：跟随系统主题，品牌色在深色下提亮以保证对比度。 -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#35A79C</Color>
                    <Color x:Key="SystemAccentColorLight1">#5FBDB4</Color>
                    <Color x:Key="SystemAccentColorLight2">#7FD0C7</Color>
                    <Color x:Key="SystemAccentColorLight3">#A5E2DA</Color>
                    <Color x:Key="SystemAccentColorDark1">#1E9188</Color>
                    <Color x:Key="SystemAccentColorDark2">#177A72</Color>
                    <Color x:Key="SystemAccentColorDark3">#0F625C</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- MemoIsle 品牌色（teal）：覆盖 WinUI 强调色，使按钮、开关、进度环与 Web/Android 端一致。 -->
            <Color x:Key="SystemAccentColor">#177A72</Color>
            <Color x:Key="SystemAccentColorLight1">#1E9188</Color>
            <Color x:Key="SystemAccentColorLight2">#35A79C</Color>
            <Color x:Key="SystemAccentColorLight3">#5FBDB4</Color>
            <Color x:Key="SystemAccentColorDark1">#0F625C</Color>
            <Color x:Key="SystemAccentColorDark2">#0A4A45</Color>
            <Color x:Key="SystemAccentColorDark3">#063330</Color>

            <!-- 统一的卡片圆角与内边距令牌，供各界面复用。 -->
            <CornerRadius x:Key="MemoCardCornerRadius">10</CornerRadius>
            <Thickness x:Key="MemoCardPadding">14,12,14,10</Thickness>

            <!-- 列表项容器：撑满宽度、去掉默认内边距与最小高度，避免卡片显示偏窄、间距叠加。 -->
            <Style x:Key="MemoListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="MinHeight" Value="0" />
            </Style>

            <!-- 卡片视图的网格项：固定尺寸，保证每张卡片大小一致。 -->
            <Style x:Key="MemoCardItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="6" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Width" Value="250" />
                <Setter Property="Height" Value="224" />
            </Style>

            <!-- 图标动作按钮：行内操作使用，无边框，悬停时才显示背景。 -->
            <Style x:Key="IconActionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!-- 过滤 chip：小尺寸、浅边框、圆角胶囊。 -->
            <Style x:Key="FilterChipStyle" TargetType="Button">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="MinHeight" Value="28" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
