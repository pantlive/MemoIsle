<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MemoIsle.Desktop.TranslatePopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MemoIsle 翻译">

    <Grid
        x:Name="RootBorder"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderThickness="1"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        CornerRadius="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="12,8" ColumnSpacing="8" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="HeaderText"
                FontSize="12"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                x:Name="BusyText"
                Grid.Column="1"
                FontSize="12"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Text="翻译中…" />
        </Grid>

        <Border
            Grid.Row="1"
            Margin="12,0"
            Padding="10"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="SourceText"
                        FontSize="12"
                        TextWrapping="Wrap"
                        MaxLines="4"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        x:Name="ResultText"
                        FontSize="15"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                    <TextBlock
                        x:Name="ErrorText"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Visibility="Collapsed"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8"
            Padding="12,8">
            <Button x:Name="CopyButton" Content="复制译文" FontSize="12" Click="OnCopyClick" />
            <Button x:Name="SaveButton" Content="收藏到 MemoIsle" FontSize="12" Click="OnSaveClick" />
            <Button
                x:Name="RetryButton"
                Content="重试"
                FontSize="12"
                Visibility="Collapsed"
                Click="OnRetryClick" />
            <Button Content="关闭" FontSize="12" Click="OnCloseClick" />
        </StackPanel>

        <TextBlock
            x:Name="HintText"
            Grid.Row="3"
            Padding="12,0,12,8"
            FontSize="11"
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
    </Grid>
</Window>
