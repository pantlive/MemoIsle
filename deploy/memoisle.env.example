# MemoIsle 后端环境变量模板。复制到 /etc/memoisle/memoisle.env 后按注释修改。
# 文件里有密钥，权限必须是 600，属主 root：
#   sudo install -m 600 -o root -g root deploy/memoisle.env.example /etc/memoisle/memoisle.env

# ---- 必改 ----------------------------------------------------------------
# Web 的访问地址。CORS 白名单、邮件里的链接都用它。多个地址用英文逗号分隔。
MEMOISLE_CORS_ORIGINS=https://memo.example.com
MEMOISLE_WEB_BASE_URL=https://memo.example.com

# 登录会话签名密钥。留空时自动生成到数据目录的 .memoisle-auth.key 并沿用；
# 想显式固定就填一个随机值：openssl rand -base64 32
# 注意：一旦有用户登录或绑定过云盘，就不要再改它，否则会话失效、云盘凭据无法解密。
MEMOISLE_AUTH_TOKEN_SECRET=

# ---- 数据位置（一般不用改） -------------------------------------------------
MEMOISLE_DATABASE_URL=sqlite+pysqlite:////var/lib/memoisle/memoisle.db
MEMOISLE_AUDIO_DIRECTORY=/var/lib/memoisle/audio
MEMOISLE_IMAGE_DIRECTORY=/var/lib/memoisle/images
MEMOISLE_SANOTTS_CACHE_DIRECTORY=/var/lib/memoisle/sanotts
MEMOISLE_EMAIL_OUTBOX_DIRECTORY=/var/lib/memoisle/email_outbox

# ---- 2 核 2G 机器建议的开关 -------------------------------------------------
# 本地 OCR 加载模型后常驻约 1.1 GB、峰值约 1.65 GB，2G 机器放不下，保持 none。
# 需要识别图片文字时改成 llm，并配置下面的视觉模型（图片会发给该服务）。
MEMOISLE_IMAGE_OCR_PROVIDER=none
# 服务端 TTS 依赖 sanotts，精简部署没有安装。关闭后客户端回退到词典音频与系统 TTS。
MEMOISLE_TTS_PROVIDER=none
# 生产环境必须关闭开发登录。
MEMOISLE_AUTH_DEV_MODE=false

# ---- 邮件（注册验证码、找回密码，必配其一） --------------------------------
MEMOISLE_EMAIL_PROVIDER=smtp
MEMOISLE_SMTP_HOST=smtp.example.com
MEMOISLE_SMTP_PORT=587
MEMOISLE_SMTP_USERNAME=
MEMOISLE_SMTP_PASSWORD=
MEMOISLE_SMTP_FROM_ADDRESS=MemoIsle <no-reply@example.com>
MEMOISLE_SMTP_USE_TLS=true
MEMOISLE_SMTP_USE_SSL=false

# ---- 可选：大模型（分类模板生成、会议总结、图片 OCR=llm 时的视觉模型） --------
# MEMOISLE_DEEPSEEK_API_KEY=
# MEMOISLE_LLM_BASE_URL=
# MEMOISLE_LLM_API_KEY=
# MEMOISLE_LLM_MODEL=
# MEMOISLE_VISION_MODEL=
